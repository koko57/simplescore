{
    "expo": {
        "name": "ScoreBoard",
        "slug": "ScoreBoard",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "light",
        "scheme": "scoreboard",
        "newArchEnabled": true,
        "splash": {
            "image": "./assets/icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#9575CD"
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.koko57.scoreboard",
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false
            }
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#9575CD"
            },
            "package": "com.koko57.scoreboard",
            "edgeToEdgeEnabled": true
        },
        "plugins": ["expo-router", "expo-font"],
        "extra": {
            "router": {},
            "eas": {
                "projectId": "83ca0645-ef32-4b35-b36f-517991ba989a"
            }
        },
        "owner": "koko57"
    }
}
